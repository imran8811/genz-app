# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
!android/app/debug.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# NOTE: android/ is intentionally NOT ignored — it carries the release signing
# config and manifest fixes, which must survive `expo prebuild`. Only its build
# outputs are ignored, below.
/ios

# Android build outputs (regenerated by gradle; never commit)
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/local.properties
android/app/release/
android/keystore.properties

# Release artifacts (they belong in the Play Console, not in git)
*.apk
*.aab
*.aar
build-apk.log
